<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Fundo" Color="#17191E"/>
  <SolidColorBrush x:Key="Barra" Color="#22252C"/>
  <SolidColorBrush x:Key="Borda" Color="#30343C"/>
  <SolidColorBrush x:Key="Texto" Color="#E9EBEE"/>
  <SolidColorBrush x:Key="Suave" Color="#8B909A"/>
  <SolidColorBrush x:Key="Ouro" Color="#F2B544"/>
  <SolidColorBrush x:Key="Verde" Color="#35D07F"/>
  <SolidColorBrush x:Key="Vermelho" Color="#FF5A64"/>
  <SolidColorBrush x:Key="Azul" Color="#5B9BFF"/>
  <!-- selos de uso do item (wiki): missão diária, forja, refino -->
  <SolidColorBrush x:Key="CorDiaria" Color="#3D7BEA"/>
  <SolidColorBrush x:Key="CorForja" Color="#E07B24"/>
  <SolidColorBrush x:Key="CorRefino" Color="#8A5CE6"/>
  <Style x:Key="SeloUso" TargetType="Border">
    <Setter Property="Width" Value="11"/>
    <Setter Property="Height" Value="11"/>
    <Setter Property="CornerRadius" Value="5.5"/>
    <Setter Property="Margin" Value="0,0,1,0"/>
    <Setter Property="BorderBrush" Value="#17191E"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Style.Resources>
      <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="5.5"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
    </Style.Resources>
  </Style>

  <!-- botão pequeno da barra de título -->
  <Style x:Key="BotaoTitulo" TargetType="Button">
    <Setter Property="Width" Value="18"/>
    <Setter Property="Height" Value="18"/>
    <Setter Property="Foreground" Value="#9AA0AA"/>
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
    <Setter Property="FontSize" Value="8"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" CornerRadius="5" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#353943"/><Setter Property="Foreground" Value="White"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- botões da barra de atalhos (abrem os outros analyzers) -->
  <Style x:Key="BotaoAtalho" TargetType="Button">
    <Setter Property="Height" Value="24"/>
    <Setter Property="Foreground" Value="#C9CDD4"/>
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Margin" Value="0,0,3,3"/>
    <Setter Property="Padding" Value="6,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" CornerRadius="6" Background="#262930" BorderBrush="#30343C" BorderThickness="1" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#30343C"/><Setter Property="Foreground" Value="White"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- borda invisível que muda o tamanho da janela -->
  <Style x:Key="PuxadorInvisivel" TargetType="Thumb">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- barra de rolagem fina e escura -->
  <Style x:Key="BarraRolagem" TargetType="ScrollBar">
    <Setter Property="Width" Value="5"/>
    <Setter Property="MinWidth" Value="5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.Thumb>
              <Thumb>
                <Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="2.5" Background="#3A3F49"/></ControlTemplate></Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- janela compacta: barra de título fina com ícone, nome e botões -->
  <Style x:Key="JanelaAnalyzer" TargetType="Window">
    <Setter Property="WindowStyle" Value="None"/>
    <Setter Property="AllowsTransparency" Value="True"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="ResizeMode" Value="NoResize"/>
    <Setter Property="SizeToContent" Value="Height"/>
    <Setter Property="ShowInTaskbar" Value="False"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Foreground" Value="#E9EBEE"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Window">
          <!-- bordas e canto (PART_Ajustar*) mudam a largura e a altura; o conteúdo se reorganiza e, se não couber, rola -->
          <Grid x:Name="PART_Raiz">
          <Border CornerRadius="10" Background="#17191E" BorderBrush="#30343C" BorderThickness="1" Margin="4">
            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.6"/></Border.Effect>
            <DockPanel>
              <Border x:Name="PART_Titulo" DockPanel.Dock="Top" Height="24" CornerRadius="10,10,0,0" Background="#22252C" BorderBrush="#30343C" BorderThickness="0,0,0,1">
                <Grid Margin="7,0,4,0">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="13" Height="13" CornerRadius="4" Background="{TemplateBinding Tag}">
                      <TextBlock Text="{TemplateBinding Uid}" FontFamily="Segoe MDL2 Assets" FontSize="8" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold" FontSize="11.5" Margin="6,0,0,1" Foreground="#E9EBEE" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="PART_Recolher" Style="{StaticResource BotaoTitulo}" Content="&#xE921;" ToolTip="Recolher"/>
                    <Button x:Name="PART_Fechar" Style="{StaticResource BotaoTitulo}" Content="&#xE8BB;" ToolTip="Fechar"/>
                  </StackPanel>
                </Grid>
              </Border>
              <ScrollViewer x:Name="PART_Rolagem" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="8,6,4,8">
                <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource BarraRolagem}"/></ScrollViewer.Resources>
                <ContentPresenter x:Name="PART_Corpo" Margin="0,0,4,0" VerticalAlignment="Top"/>
              </ScrollViewer>
            </DockPanel>
          </Border>
          <Thumb x:Name="PART_AjustarLargura" Visibility="Collapsed" Width="6" Margin="0,14,1,14" HorizontalAlignment="Right" Cursor="SizeWE" Style="{StaticResource PuxadorInvisivel}"/>
          <Thumb x:Name="PART_AjustarAltura" Visibility="Collapsed" Height="6" Margin="14,0,14,1" VerticalAlignment="Bottom" Cursor="SizeNS" Style="{StaticResource PuxadorInvisivel}"/>
          <Thumb x:Name="PART_Ajustar" Visibility="Collapsed" Width="13" Height="13" Margin="0,0,6,6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"
                 ToolTip="Arraste o canto ou as bordas para mudar o tamanho da janela. Clique duplo volta ao tamanho original.">
            <Thumb.Template>
              <ControlTemplate TargetType="Thumb">
                <Grid Background="Transparent">
                  <Path Data="M 12,3 L 3,12 M 12,7 L 7,12 M 12,11 L 11,12" Stroke="#5A606B" StrokeThickness="1.2"/>
                </Grid>
              </ControlTemplate>
            </Thumb.Template>
          </Thumb>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- linha "rótulo ......... valor" -->
  <Style x:Key="Rotulo" TargetType="TextBlock">
    <Setter Property="Foreground" Value="#9AA0AA"/>
    <Setter Property="Margin" Value="0,1"/>
  </Style>
  <Style x:Key="Valor" TargetType="TextBlock">
    <Setter Property="Foreground" Value="#E9EBEE"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="Margin" Value="0,1"/>
  </Style>
  <Style x:Key="Secao" TargetType="TextBlock">
    <Setter Property="Foreground" Value="#E9EBEE"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Margin" Value="0,7,0,3"/>
  </Style>
  <Style x:Key="Separador" TargetType="Border">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Background" Value="#2A2E35"/>
    <Setter Property="Margin" Value="0,4"/>
  </Style>

  <Style x:Key="BarraFina" TargetType="ProgressBar">
    <Setter Property="Height" Value="4"/>
    <Setter Property="Maximum" Value="100"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border CornerRadius="2" Background="#2C3038"/>
            <Border x:Name="PART_Track"/>
            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2" Background="{TemplateBinding Foreground}"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- linha com barra: nome, valor e porcentagem (dano por tipo, por fonte, kills) -->
  <DataTemplate x:Key="LinhaBarra">
    <StackPanel Margin="0,2,0,4">
      <!-- valor à direita; o nome usa o resto da largura (janela mais larga = nome inteiro) -->
      <DockPanel>
        <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Fill="{Binding Cor}" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <TextBlock DockPanel.Dock="Right" Margin="6,0,0,0">
          <Run Text="{Binding Valor, Mode=OneWay}" Foreground="#E9EBEE" FontWeight="SemiBold"/>
          <Run Text="{Binding Extra, Mode=OneWay}" Foreground="#7D828C"/>
        </TextBlock>
        <TextBlock Text="{Binding Nome}" Foreground="#C9CDD4" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
      <ProgressBar Style="{StaticResource BarraFina}" Value="{Binding Percentual, Mode=OneWay}" Foreground="{Binding Cor}" Margin="0,3,0,0"/>
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
