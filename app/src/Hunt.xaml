<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- personagem (ou cliente) a que este analyzer está conectado -->
  <TextBlock Text="{Binding Personagem}" ToolTip="{Binding Status}" Visibility="{Binding PersonagemVis}" FontSize="12" FontWeight="SemiBold" Foreground="#E9EBEE" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
  <Grid Margin="0,0,0,4">
    <Grid Width="16" Height="18" HorizontalAlignment="Left" Background="Transparent" ToolTip="{Binding Status}">
      <Ellipse Width="7" Height="7" Fill="{Binding CorStatus}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
    </Grid>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="BtnConfig" Style="{StaticResource BotaoTitulo}" Content="&#xE713;" ToolTip="Configurações: idioma, tamanho do texto, contraste e fundo"/>
      <Button x:Name="BtnRelatorio" Style="{StaticResource BotaoTitulo}" Content="&#xE722;" ToolTip="Gerar relatório da caçada em imagem (1920x1080 e 1080x1920)"/>
      <Button x:Name="BtnCopiar" Style="{StaticResource BotaoTitulo}" Content="&#xE8C8;" ToolTip="Copiar o resumo da hunt"/>
      <Button x:Name="BtnTravar" Style="{StaticResource BotaoTitulo}" Content="&#xE785;" Opacity="0.45" ToolTip="Travar: o analyzer fica visível mas os cliques passam para o jogo (Ctrl+Shift+L)"/>
      <Button x:Name="BtnPausar" Style="{StaticResource BotaoTitulo}" Content="{Binding IconePausa}" ToolTip="Pausar / retomar"/>
      <Button x:Name="BtnZerar" Style="{StaticResource BotaoTitulo}" Content="&#xE72C;" ToolTip="Zerar sessão"/>
      <Button x:Name="BtnFixar" Style="{StaticResource BotaoTitulo}" Content="&#xE718;" ToolTip="Manter por cima do jogo (só aparece com o Bloodstone na frente)"/>
    </StackPanel>
  </Grid>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
      <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
      <RowDefinition/>
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Style="{StaticResource Rotulo}" Text="Sessão:"/>
    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Valor}" Text="{Binding Tempo}"/>
    <TextBlock Grid.Row="1" Style="{StaticResource Rotulo}" Text="XP ganho:"/>
    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Valor}" Text="{Binding XpTotal}"/>
    <TextBlock Grid.Row="2" Style="{StaticResource Rotulo}" Text="XP/h:"/>
    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Valor}" Text="{Binding XpHora}" Foreground="{StaticResource Azul}"/>
    <Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource Separador}"/>
    <TextBlock Grid.Row="4" Style="{StaticResource Rotulo}" Text="Loot:"/>
    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Valor}" Text="{Binding LootTotal}" Foreground="{StaticResource Ouro}"/>
    <TextBlock Grid.Row="5" Style="{StaticResource Rotulo}" Text="Supplies:"/>
    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Valor}" Text="{Binding Supplies}" ToolTip="Gasto com poções e outros supplies (preço de NPC da wiki)"/>
    <TextBlock Grid.Row="6" Style="{StaticResource Rotulo}" Text="Balanço:"/>
    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Valor}" Text="{Binding Balanco}" Foreground="{Binding CorBalanco}"/>
    <TextBlock Grid.Row="7" Style="{StaticResource Rotulo}" Text="Balanço/h:"/>
    <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource Valor}" Text="{Binding BalancoHora}" Foreground="{Binding CorBalanco}"/>
    <Border Grid.Row="8" Grid.ColumnSpan="2" Style="{StaticResource Separador}"/>
    <TextBlock Grid.Row="9" Style="{StaticResource Rotulo}" Text="Dano:"/>
    <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource Valor}" Text="{Binding DanoTotal}"/>
    <TextBlock Grid.Row="10" Style="{StaticResource Rotulo}" Text="Dano/h:"/>
    <TextBlock Grid.Row="10" Grid.Column="1" Style="{StaticResource Valor}" Text="{Binding DanoHora}" Foreground="{StaticResource Vermelho}"/>
    <TextBlock Grid.Row="11" Style="{StaticResource Rotulo}" Text="Recebido:"/>
    <TextBlock Grid.Row="11" Grid.Column="1" Style="{StaticResource Valor}" Text="{Binding RecebidoTotal}"/>
    <TextBlock Grid.Row="12" Style="{StaticResource Rotulo}" Text="Cura:"/>
    <TextBlock Grid.Row="12" Grid.Column="1" Style="{StaticResource Valor}" Text="{Binding Cura}" Foreground="{StaticResource Verde}" ToolTip="Vida recuperada (poções, magias e regeneração)"/>
  </Grid>
  <TextBlock Style="{StaticResource Secao}" Text="Monstros mortos:"/>
  <TextBlock Text="nenhum ainda" Foreground="#626772" Margin="6,0,0,0" Visibility="{Binding SemKills}"/>
  <ItemsControl ItemsSource="{Binding KillsResumo}">
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <TextBlock Margin="6,0,0,1" TextTrimming="CharacterEllipsis">
          <Run Text="{Binding Valor, Mode=OneWay}" Foreground="#E9EBEE" FontWeight="SemiBold"/><Run Text="x " Foreground="#7D828C"/><Run Text="{Binding Nome, Mode=OneWay}" Foreground="#C9CDD4"/>
        </TextBlock>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
  <TextBlock Text="{Binding KillsMais}" Foreground="#626772" Margin="6,0,0,0" FontSize="10.5"/>
  <Border Style="{StaticResource Separador}" Margin="0,6,0,6"/>
  <UniformGrid Columns="5" Margin="0,0,-3,-3">
    <Button x:Name="AbrirLoot" Style="{StaticResource BotaoAtalho}" Padding="1,0" ToolTip="Loot Analyzer"><TextBlock Text="Loot"/></Button>
    <Button x:Name="AbrirXp" Style="{StaticResource BotaoAtalho}" Padding="1,0" ToolTip="XP Analyzer"><TextBlock Text="XP"/></Button>
    <Button x:Name="AbrirKills" Style="{StaticResource BotaoAtalho}" Padding="1,0" ToolTip="Kills Analyzer"><TextBlock Text="Kills"/></Button>
    <Button x:Name="AbrirSupplies" Style="{StaticResource BotaoAtalho}" Padding="1,0" ToolTip="Supplies"><TextBlock Text="Supp."/></Button>
    <Button x:Name="AbrirRecebido" Style="{StaticResource BotaoAtalho}" Padding="1,0" ToolTip="Dano Recebido"><TextBlock Text="Input"/></Button>
  </UniformGrid>
  <!-- caçada em grupo (Party Hunt): botão da largura da janela -->
  <Button x:Name="BtnGrupo" Style="{StaticResource BotaoAtalho}" Margin="0,3,0,0" Height="26" ToolTip="Junte até 6 analyzers e veja o loot, os supplies e o balanço do grupo">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#C9ABFF" VerticalAlignment="Center" Margin="0,1,6,0"/>
      <TextBlock Text="Hunt em grupo" VerticalAlignment="Center"/>
      <Border CornerRadius="6" Background="#2E2440" BorderBrush="#4A3A66" BorderThickness="1" Padding="5,0,5,1" Margin="7,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="em teste" FontSize="8.5" Foreground="#C9ABFF"/>
      </Border>
    </StackPanel>
  </Button>
</StackPanel>
