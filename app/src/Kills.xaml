<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
    <TextBlock Style="{StaticResource Rotulo}" Text="Kills:"/>
    <TextBlock Grid.Column="1" Style="{StaticResource Valor}" Text="{Binding TotalKills}"/>
    <TextBlock Grid.Row="1" Style="{StaticResource Rotulo}" Text="Kills/h:"/>
    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Valor}" Text="{Binding KillsHora}"/>
    <TextBlock Grid.Row="2" Style="{StaticResource Rotulo}" Text="Espécies:"/>
    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Valor}" Text="{Binding Especies}"/>
  </Grid>
  <Border Style="{StaticResource Separador}" Margin="0,5,0,4"/>
  <TextBlock Text="nenhuma morte ainda" Foreground="#626772" Visibility="{Binding SemKills}"/>
  <ItemsControl ItemsSource="{Binding Kills}">
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <Grid Margin="0,2,0,3">
          <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="24" Height="24" CornerRadius="6" Background="#22252C" HorizontalAlignment="Left">
            <Image Source="{Binding Imagem}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <Grid>
              <TextBlock Text="{Binding Nome}" Foreground="#C9CDD4" TextTrimming="CharacterEllipsis" MaxWidth="100" HorizontalAlignment="Left"/>
              <TextBlock HorizontalAlignment="Right"><Run Text="{Binding Valor, Mode=OneWay}" Foreground="#E9EBEE" FontWeight="SemiBold"/><Run Text="{Binding Extra, Mode=OneWay}" Foreground="#7D828C"/></TextBlock>
            </Grid>
            <ProgressBar Style="{StaticResource BarraFina}" Value="{Binding Percentual, Mode=OneWay}" Foreground="{Binding Cor}" Margin="0,3,0,0"/>
          </StackPanel>
        </Grid>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</StackPanel>
